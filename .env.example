# ---- Supabase (content database) ----
# 1. Create a free project at https://supabase.com
# 2. In the SQL editor, run the schema from SUPABASE_SETUP.md
# 3. Copy your project URL and service-role key from Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Admin panel ----
# Long random string used to sign admin session cookies (required in production)
ADMIN_SECRET=change-this-to-a-long-random-string
